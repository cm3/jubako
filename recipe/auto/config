#!/bin/sh
set -eu
lb config noauto \
    --ignore-system-defaults \
    --mode debian --distribution trixie --architectures amd64 \
    --binary-image iso-hybrid --bootloaders "syslinux grub-efi" \
    --uefi-secure-boot enable --archive-areas "main non-free-firmware" \
    --apt-recommends false --debootstrap-options "--variant=minbase" \
    --linux-flavours amd64 --debian-installer none \
    --firmware-binary false --firmware-chroot false \
    --memtest none --win32-loader false --source false --checksums sha256 \
    --iso-volume JA_LIVE_STARTER \
    --bootappend-live "boot=live components nopersistence username=user hostname=ja-live locales=en_US.UTF-8 keyboard-model=pc105 keyboard-layouts=jp" \
    "$@"
